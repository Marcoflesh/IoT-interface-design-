# Copia este archivo como .env y llena los valores:  cp .env.example .env
# El .env NO se sube a GitHub. Los comentarios van en su propia línea, nunca al final de un valor.

# ============ 1. MariaDB ============
# Fedora: contraseña de root de TU MariaDB (la que usas en DBeaver). Vacía si root entra con sudo.
# Docker (docker-compose.yml): contraseña de root de la MariaDB del contenedor; la inventas.
DB_ROOT_PASSWORD=
DB_NAME=calidad_agua
DB_USER=agua
# Contraseña NUEVA para el usuario agua (el script lo crea con esta). Es la que pones en DBeaver.
DB_PASSWORD=cambia-esta-clave
# Solo Fedora: dónde está tu MariaDB.
DB_HOST=127.0.0.1
DB_PORT=3306
# Solo Windows/Docker (docker-compose.yml): puerto de tu compu para entrar a la MariaDB del contenedor.
# Pon 3307 si ya tienes MariaDB o MySQL instalado en Windows usando el 3306.
DB_PUERTO_LOCAL=3306
# Solo Windows/Docker: puerto de la página y de la API. Cámbialo (ej. 8090) si Windows dice que el 8080 está reservado.
WEB_PUERTO=8080

# ============ 2. API ============
# Llave que manda el ESP32 en el header X-API-Key (mínimo 16 caracteres). Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
ESP32_API_KEY=pega-aqui-una-llave-aleatoria

# ============ 3. ThingSpeak ============
# Channel ID: el número que aparece arriba en la página del canal.
THINGSPEAK_CHANNEL_ID=
# Read API Key: solo si el canal es privado. Vacía si lo hiciste público (Sharing).
THINGSPEAK_READ_KEY=
# Write API Key: la usan el simulador y la prueba de escritura. La del ESP32 real va en secretos.h.
THINGSPEAK_WRITE_KEY=

# ============ 4. Puente ThingSpeak → MariaDB (perfil "thingspeak") ============
# Nombre de dispositivo con el que quedan en MariaDB. Usa esp32-sim-ts mientras el canal tenga datos simulados.
PUENTE_DISPOSITIVO=esp32-1-ts
# Cada cuántos segundos revisa el canal (mínimo 15).
PUENTE_INTERVALO=60

# ============ 5. ESP32 virtual (perfil "simulador") ============
# Muestra inicial: llave, purificada, tierra, sal, vinagre, tierraVinagre o jabonosa.
SIM_MUESTRA=llave
# 1 = cambia de muestra sola cada SIM_GUION_MIN minutos.
SIM_GUION=1
SIM_GUION_MIN=5
