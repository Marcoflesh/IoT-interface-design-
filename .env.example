# Copia este archivo como .env y cambia los valores. El .env NO se sube a GitHub.

# MariaDB
DB_ROOT_PASSWORD=cambia-esta-clave-root
DB_NAME=calidad_agua
DB_USER=agua
DB_PASSWORD=cambia-esta-clave

# Llave que manda el ESP32 en el header X-API-Key (mínimo 16 caracteres).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(16))"
ESP32_API_KEY=pega-aqui-una-llave-aleatoria
