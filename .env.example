# Copia este archivo como .env y cambia los valores. El .env NO se sube a GitHub.

# MariaDB
# Docker: contraseña de root de la MariaDB del contenedor (la inventas).
# Fedora: contraseña de root de TU MariaDB (la que usas en DBeaver). Vacía si root entra con sudo.
DB_ROOT_PASSWORD=cambia-esta-clave-root
DB_NAME=calidad_agua
DB_USER=agua
DB_PASSWORD=cambia-esta-clave

# Llave que manda el ESP32 en el header X-API-Key (mínimo 16 caracteres).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(16))"
ESP32_API_KEY=pega-aqui-una-llave-aleatoria

# Solo para docker-compose.fedora.yml (usa la MariaDB instalada en la laptop; ver FEDORA.md)
DB_HOST=127.0.0.1
DB_PORT=3306

# ESP32 virtual (opcional, perfil "simulador")
# Write API Key de ThingSpeak: solo si quieres que el simulador también publique allá.
THINGSPEAK_WRITE_KEY=
SIM_MUESTRA=llave
# 1 = cambia de muestra sola cada SIM_GUION_MIN minutos (llave, tierra, vinagre…)
SIM_GUION=1
SIM_GUION_MIN=5
