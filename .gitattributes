# Finales de línea fijos para que todo funcione igual clonando en Windows, Fedora o Mac.
* text=auto
*.sh     text eol=lf
*.sql    text eol=lf
*.conf   text eol=lf
*.yml    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.ino    text eol=lf
*.h      text eol=lf
.env*    text eol=lf
*.ps1    text eol=crlf
*.png    binary
*.ico    binary
